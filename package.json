{
  "name": "mynode",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently \"nodemon ./bin/www\" \"nodemon ./workers/orderWorker.js\"",
    "start": "cross-env NODE_ENV=production concurrently \"node ./bin/www\" \"node ./workers/orderWorker.js\"",
    "worker": "cross-env NODE_ENV=production node workers/orderWorker.js",
    "pm2:start": "cross-env NODE_ENV=production pm2 start ecosystem.config.js",
    "pm2:stop": "cross-env NODE_ENV=production pm2 stop ecosystem.config.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.3"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "alipay-sdk": "^4.14.0",
    "axios": "^1.13.2",
    "bull": "^4.16.5",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "debug": "~2.6.9",
    "dotenv": "^17.3.1",
    "ejs": "~2.6.1",
    "exceljs": "^4.4.0",
    "express": "~4.16.1",
    "express-session": "^1.18.2",
    "express-validator": "^7.2.1",
    "file-saver": "^2.0.5",
    "http-errors": "~1.6.3",
    "iconv-lite": "^0.7.2",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "log4js": "^6.9.1",
    "morgan": "~1.9.1",
    "multer": "^2.0.2",
    "multer-aliyun-oss": "^2.1.3",
    "mysql2": "^3.14.2",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.19.1",
    "redis": "^5.9.0",
    "sequelize": "^6.37.7",
    "svg-captcha": "^1.4.0"
  }
}
